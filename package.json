{
  "name": "bop-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web UI for bop-server: scene setup, asset library, jobs and exports.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "contract:generate": "openapi-typescript contract/api.openapi.json -o src/api/schema.d.ts",
    "contract:sync": "bun scripts/sync-contract.mjs",
    "contract:check": "bun scripts/sync-contract.mjs --check"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@tanstack/react-query": "5.103.3",
    "oidc-client-ts": "3.5.0",
    "openapi-fetch": "0.17.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.4",
    "smol-toml": "1.9.0",
    "three": "0.169.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "5.1.4",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "packageManager": "bun@1.3.14"
}
